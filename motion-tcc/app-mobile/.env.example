# Opcional: endereço de uma API acessível pelo telefone.
# Para usar apenas o modo local/offline do app, deixe sem configurar.
# Para login/sincronização online, use a URL HTTPS pública do backend:
# EXPO_PUBLIC_API_URL=https://SEU_DOMINIO/api.php
# APP_API_BASE_URL=https://SEU_DOMINIO/api.php

# Desenvolvimento na mesma rede Wi-Fi que o computador com Docker:
# EXPO_PUBLIC_API_URL=http://IP_DO_COMPUTADOR:8080/api.php
# APP_API_BASE_URL=http://IP_DO_COMPUTADOR:8080/api.php

# Opcional: URL do serviço local de hardware/botão físico
# APP_HARDWARE_BASE_URL=http://IP_DO_SERVIDOR:5000
